{
  "name": "@mns/api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx ./src/db/seed.ts"
  },
  "exports": {
    "./types": "./src/lib/types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "3.1149.0",
    "@epic-web/remember": "1.1.0",
    "@mns/email": "workspace:*",
    "@mns/utils": "workspace:*",
    "@trpc/server": "11.19.0",
    "@upstash/redis": "catalog:",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "dotenv": "catalog:",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "catalog:",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "supertest": "^7.3.1",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
