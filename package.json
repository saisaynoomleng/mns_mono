    "clean": "turbo clean",
    "test": "turbo test"
  },
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@manypkg/cli": "0.25.1",
    "prettier": "3.9.10",
    "syncpack": "15.3.3",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
